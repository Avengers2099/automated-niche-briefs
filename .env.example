# Copy these into GitHub repository secrets; never commit an actual .env file.
GEMINI_API_KEY=replace_with_google_ai_studio_key
RAZORPAY_PAYMENT_LINK=https://rzp.io/l/replace_with_your_payment_page

# Optional: enables automatic Telegram channel announcements.
TELEGRAM_BOT_TOKEN=123456:replace_with_bot_token
TELEGRAM_CHAT_ID=@replace_with_your_public_channel

# Optional content configuration (GitHub repository variables, not secrets).
NICHE=AI automation for Indian small businesses
AUDIENCE=Indian freelancers, agencies, and small-business owners
OFFER_NAME=Daily AI Automation Opportunity Brief
PRICE_TEXT=₹999/month
GEMINI_MODEL=gemini-2.0-flash
